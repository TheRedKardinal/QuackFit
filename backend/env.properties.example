# Copia questo file in env.properties (escluso da Git) e compila i valori.

DB_URL=jdbc:postgresql://localhost:5432/quackfit
DB_USERNAME=
DB_PASSWORD=

# Segreto per firmare i JWT: almeno 32 caratteri casuali (obbligatorio)
JWT_SECRET=
# Durata del token (facoltativa, default 24h)
# JWT_DURATA=24h
# Origine del frontend ammessa dal CORS (facoltativa, default http://localhost:5173)
# FRONTEND_URL=http://localhost:5173

# Superadmin creato all'avvio se nel database non ce n'è uno (obbligatorie finché non esiste).
# La password segue le regole della registrazione: almeno 8 caratteri, una maiuscola, un numero e un carattere speciale
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Email: log (default, codici scritti nel log), smtp (Gmail, solo locale) oppure brevo
# MAIL_MODALITA=log
# Mittente: obbligatorio con smtp e brevo (con Brevo deve essere un mittente verificato)
MAIL_MITTENTE=
# MAIL_NOME_MITTENTE=QuackFit
# Solo con smtp: account Gmail e password per app
MAIL_USERNAME=
MAIL_PASSWORD=
# Solo con brevo: chiave API
BREVO_API_KEY=

# Cloudinary per la foto profilo: facoltative in locale (senza, il caricamento della foto risponde 500),
# obbligatorie in produzione (l'app non parte se ne manca una)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
