# Copia in e2e/.env.e2e (escluso da Git) e compila: valori di prova SOLO per i test end to end in locale.
# Superadmin creato dal backend delle prove al primo avvio sul database quackfit_e2e (stesse regole della password).
E2E_SUPERADMIN_EMAIL=
E2E_SUPERADMIN_PASSWORD=
# Facoltativo: indirizzo JDBC del database delle prove (predefinito jdbc:postgresql://localhost:5432/quackfit_e2e);
# utente e password del database restano quelli di backend/env.properties
# E2E_DB_URL=
